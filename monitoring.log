# Ruta del archivo de log de monitoreo
monitoring_log_path = 'monitoring.log'

# Comprobar si existe el archivo y mostrar su contenido
if os.path.exists(monitoring_log_path):
    print(f"--- Mostrando el contenido de {monitoring_log_path} ---\n")
    with open(monitoring_log_path, 'r') as file:
        log_content = file.read()
        print(log_content)
else:
    print(f"❌ El archivo {monitoring_log_path} aún no ha sido generado en el sistema.")


