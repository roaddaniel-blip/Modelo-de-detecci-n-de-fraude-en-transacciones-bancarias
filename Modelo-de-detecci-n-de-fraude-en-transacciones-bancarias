        "import logging\n",
        "import pandas as pd\n",
        "\n",
        "# 1. Configurar o recuperar el logger de incidentes\n",
        "incidents_logger = logging.getLogger('incidents')\n",
        "if not incidents_logger.handlers:\n",
        "    incidents_logger.setLevel(logging.INFO)\n",
        "    ih = logging.FileHandler('incidents.log', mode='w')\n",
        "    ih.setFormatter(logging.Formatter('%(asctime)s - %(levelname)s - %(message)s'))\n",
        "    incidents_logger.addHandler(ih)\n",
        "\n",
        "# 2. Definición estructurada del catálogo de incidentes según nueva especificación\n",
        "tabla_sla = [\n",
        "    {\n",
        "        \"Prioridad\": \"P1 · Crítica\",\n",
        "        \"Descripción\": \"Indisponibilidad generalizada o deterioro grave de detección con impacto confirmado\",\n",
        "        \"Tiempo objetivo de respuesta\": \"≤ 5 minutos\",\n",
        "        \"Responsable inicial\": \"SRE / Operaciones\",\n",
        "        \"Runbook\": \"RB-002\"\n",
        "    },\n",
        "    {\n",
        "        \"Prioridad\": \"P2 · Alta\",\n",
        "        \"Descripción\": \"Degradación importante de latencia, precision o recall\",\n",
        "        \"Tiempo objetivo de respuesta\": \"≤ 15 minutos\",\n",
        "        \"Responsable inicial\": \"MLOps / Data Science\",\n",
        "        \"Runbook\": \"RB-001\"\n",
        "    },\n",
        "    {\n",
        "        \"Prioridad\": \"P3 · Media\",\n",
        "        \"Descripción\": \"Data drift moderado o anomalía sin impacto inmediato\",\n",
        "        \"Tiempo objetivo de respuesta\": \"≤ 1 hora\",\n",
        "        \"Responsable inicial\": \"MLOps / Data Engineering\",\n",
        "        \"Runbook\": \"RB-003\"\n",
        "    },\n",
        "    {\n",
        "        \"Prioridad\": \"P4 · Baja\",\n",
        "        \"Descripción\": \"Eventos preventivos o informativos\",\n",
        "        \"Tiempo objetivo de respuesta\": \"Revisión programada\",\n",
        "        \"Responsable inicial\": \"Equipo responsable\",\n",
        "        \"Runbook\": \"N/A\"\n",
        "    }\n",
        "]\n",
        "df_sla = pd.DataFrame(tabla_sla)\n",
        "\n",
        "# 3. Función para simular y registrar incidentes con su SLA objetivo\n",
        "def simular_incidente(id_incidente, prioridad_corta, descripcion_error):\n",
        "    # Buscar coincidencia parcial del nombre de prioridad\n",
        "    fila_sla = df_sla[df_sla[\"Prioridad\"].str.startswith(prioridad_corta)].iloc[0]\n",
        "\n",
        "    mensaje_log = f\"[{id_incidente}] [{fila_sla['Prioridad']}] ALERTA ACTIVADA: {descripcion_error} | Runbook asociado: {fila_sla['Runbook']} | SLA Objetivo: {fila_sla['Tiempo objetivo de respuesta']} | Responsable: {fila_sla['Responsable inicial']}\"\n",
        "\n",
        "    if \"P1\" in prioridad_corta:\n",
        "        incidents_logger.error(mensaje_log)\n",
        "    elif \"P2\" in prioridad_corta:\n",
        "        incidents_logger.warning(mensaje_log)\n",
        "    else:\n",
        "        incidents_logger.info(mensaje_log)\n",
        "\n",
        "    print(f\"✔ Incidente {id_incidente} ({fila_sla['Prioridad']}) registrado en 'incidents.log'.\")\n",
        "\n",
        "# Simulación de eventos reales descritos\n",
        "simular_incidente(\"INC-001\", \"P2\", \"Recall de v3 degradado a 84.6% (Umbral mínimo: 90%)\")\n",
        "simular_incidente(\"INC-002\", \"P1\", \"Latencia p95 incrementada a 650 ms (Umbral máximo: 150 ms)\")\n",
        "\n",
        "display(df_sla)"
      ],
