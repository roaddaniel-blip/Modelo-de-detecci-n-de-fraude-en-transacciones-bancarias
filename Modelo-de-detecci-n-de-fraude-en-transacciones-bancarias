      "source": [
        "import logging\n",
        "import pandas as pd\n",
        "\n",
        "# Obtener logs existentes\n",
        "incidents_logger = logging.getLogger('incidents')\n",
        "\n",
        "# 1. Definición de la Política de Presupuestos de Error (Error Budget Policy)\n",
        "def_presupuestos = [\n",
        "    {\n",
        "        \"Indicador\": \"Recall (Fraude no Detectado)\",\n",
        "        \"SLO\": \"≥ 90.0%\",\n",
        "        \"Error Budget Mensual\": \"10.0%\",\n",
        "        \"Alerta Burn Rate (Fast Burn)\": \"Consumo > 2% en 1 hora (Prioridad P1)\",\n",
        "        \"Alerta Burn Rate (Slow Burn)\": \"Consumo > 5% en 24 horas (Prioridad P2)\"\n",
        "    },\n",
        "    {\n",
        "        \"Indicador\": \"Latencia de Inferencia p95\",\n",
        "        \"SLO\": \"≤ 150 ms\",\n",
        "        \"Error Budget Mensual\": \"5.0% de peticiones lentas\",\n",
        "        \"Alerta Burn Rate (Fast Burn)\": \"Consumo > 1% en 1 hora (Prioridad P2)\",\n",
        "        \"Alerta Burn Rate (Slow Burn)\": \"Consumo > 3% en 24 horas (Prioridad P3)\"\n",
        "    }\n",
        "]\n",
        "\n",
        "df_budget_policy = pd.DataFrame(def_presupuestos)\n",
        "\n",
        "# 2. Motor de Alertas Inteligentes basado en Impacto y Burn Rate\n",
        "def evaluar_alertas_inteligentes(recall_actual, latencia_p95, total_peticiones_hora=10000, transacciones_fraudulentas_fallidas=0):\n",
        "    print(\"\\n--- EVALUANDO ESTADO DE CONTROL DE ALERTAS INTELIGENTES ---\")\n",
        "\n",
        "    # Calcular consumo de Error Budget para Recall\n",
        "    brecha_recall = max(0.0, 0.90 - recall_actual)\n",
        "    consumo_eb_recall = brecha_recall * 100\n",
        "\n",
        "    # Clasificación de alertas según gravedad operativa\n",
        "    if consumo_eb_recall >= 5.0:\n",
        "        severity = \"CRITICAL (P1)\"\n",
        "        msg = f\"[FAST BURN ALERT] El Error Budget de Recall se consume a ritmo crítico. Consumido: {consumo_eb_recall:.2f}%. ¡Ejecutar rollback inmediato!\"\n",
        "        incidents_logger.error(f\"[SLO ALERT] [{severity}] {msg}\")\n",
        "        print(f\"❌ ALERTA ROJA: {msg}\")\n",
        "    elif consumo_eb_recall > 0.0:\n",
        "        severity = \"WARNING (P2)\"\n",
        "        msg = f\"[SLOW BURN ALERT] Degradación sostenida del Recall detectada. Consumido: {consumo_eb_recall:.2f}%.\"\n",
        "        incidents_logger.warning(f\"[SLO ALERT] [{severity}] {msg}\")\n",
        "        print(f\"⚠️ ALERTA AMARILLA: {msg}\")\n",
        "    else:\n",
        "        print(\"✅ Error Budget de Recall en perfecto estado (100% disponible).\")\n",
        "\n",
        "    # Evaluación de latencia\n",
        "    if latencia_p95 > 300:\n",
        "        msg_lat = f\"[FAST BURN ALERT] Latencia p95 crítica de {latencia_p95}ms amenaza la experiencia de usuario de checkout comercial.\"\n",
        "        incidents_logger.error(f\"[SLO ALERT] [P1] {msg_lat}\")\n",
        "        print(f\"❌ ALERTA ROJA: {msg_lat}\")\n",
        "    elif latencia_p95 > 150:\n",
        "        msg_lat = f\"[SLOW BURN ALERT] Latencia p95 de {latencia_p95}ms viola el SLO base. Monitoreando balanceo de carga.\"\n",
        "        incidents_logger.warning(f\"[SLO ALERT] [P2] {msg_lat}\")\n",
        "        print(f\"⚠️ ALERTA AMARILLA: {msg_lat}\")\n",
        "    else:\n",
        "        print(\"✅ Latencia transaccional óptima.\")\n",
        "\n",
        "# Desplegar tabla de política de Error Budget\n",
        "display(df_budget_policy)\n",
        "\n",
        "# Simular caso de consumo acelerado del presupuesto de error (Modelo v3 en producción)\n",
        "evaluar_alertas_inteligentes(recall_actual=0.846, latencia_p95=125)\n"
      ],
