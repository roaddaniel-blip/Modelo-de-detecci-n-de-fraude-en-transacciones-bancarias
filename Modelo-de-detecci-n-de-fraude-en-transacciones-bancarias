        "    \"Slack\": {\n",
        "        \"webhook_url\": \"https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX\",\n",
        "        \"habilitado\": True,\n",
        "        \"canales\": {\"P1\": \"#incidentes-criticos\", \"P2\": \"#alertas-mlopps\", \"P3\": \"#monitoreo-preventivo\"}\n",
        "    },\n",
        "    \"PagerDuty\": {\n",
        "        \"routing_key\": \"pd-service-key-ml-fraud-detection\",\n",
        "        \"habilitado\": True,\n",
        "        \"severidades\": {\"P1\": \"critical\", \"P2\": \"error\", \"P3\": \"warning\"}\n",
        "    }\n",
        "}\n",
        "\n",
        "def enviar_notificacion_slack(prioridad, mensaje):\n",
        "    \"\"\"Simula el envío de un payload JSON a un Webhook entrante de Slack\"\"\"\n",
        "    config = CONFIG_ALERTAS_CANALES[\"Slack\"]\n",
        "    if not config[\"habilitado\"]:\n",
        "        return\n",
        "\n",
        "    canal = config[\"canales\"].get(prioridad, \"#general\")\n",
        "    payload = {\n",
        "        \"channel\": canal,\n",
        "        \"username\": \"MLOps Real-Time Monitor\",\n",
        "        \"icon_emoji\": \":alert_fire:\" if prioridad == \"P1\" else \":warning:\",\n",
        "        \"text\": f\"*[{prioridad}] Alerta de Monitoreo Activa*\\n{mensaje}\"\n",
        "    }\n",
        "\n",
        "    # Simulación de la petición\n",
        "    print(f\"[SLACK CHANNEL {canal}] Notificación enviada: {mensaje}\")\n",
        "    return payload\n",
        "\n",
        "def enviar_alertamiento_pagerduty(prioridad, titulo, detalle):\n",
        "    \"\"\"Simula la integración con PagerDuty Events API v2\"\"\"\n",
        "    config = CONFIG_ALERTAS_CANALES[\"PagerDuty\"]\n",
        "    if not config[\"habilitado\"]:\n",
        "        return\n",
        "\n",
        "    severidad = config[\"severidades\"].get(prioridad, \"info\")\n",
        "    payload_pd = {\n",
        "        \"routing_key\": config[\"routing_key\"],\n",
        "        \"event_action\": \"trigger\",\n",
        "        \"payload\": {\n",
        "            \"summary\": titulo,\n",
        "            \"severity\": severidad,\n",
        "            \"source\": \"ML Model Server / Checkout Pipeline\",\n",
        "            \"custom_details\": detalle\n",
        "        }\n",
        "    }\n",
        "\n",
        "    print(f\"[PAGERDUTY triggered] [{severidad.upper()}] {titulo}. Incidente asignado al equipo On-Call.\")\n",
        "    return payload_pd\n",
        "\n",
        "def disparar_alertas_reales(prioridad, titulo, descripcion):\n",
        "    \"\"\"Orquestador de alertas según el nivel de prioridad\"\"\"\n",
        "    print(f\"\\n--- PROCESANDO ALERTA EN TIEMPO REAL: {prioridad} ---\")\n",
        "    enviar_notificacion_slack(prioridad, f\"*{titulo}*\\n{descripcion}\")\n",
        "\n",
        "    if prioridad in [\"P1\", \"P2\"]:\n",
        "        enviar_alertamiento_pagerduty(prioridad, titulo, {\"error_log\": descripcion})\n",
        "\n",
        "# Demostración del funcionamiento ante una infracción crítica\n",
        "if __name__ == \"__main__\":\n",
        "    disparar_alertas_reales(\n",
        "        prioridad=\"P1\",\n",
        "        titulo=\"SLO Violado - Latencia Crítica en Inferencia\",\n",
        "        descripcion=\"La latencia de inferencia p95 alcanzó los 650.0 ms en la última ventana (Umbral máximo: 150.0 ms).\"\n",
        "    )"
