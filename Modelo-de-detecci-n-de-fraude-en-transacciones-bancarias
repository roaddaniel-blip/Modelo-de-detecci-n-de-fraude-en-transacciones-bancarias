        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Configuración de logs para producción\n",
        "os.makedirs('logs', exist_ok=True)\n",
        "\n",
        "# Configurar logger de monitoreo y auditoría\n",
        "prod_logger = logging.getLogger('produccion_monitoreo')\n",
        "prod_logger.setLevel(logging.INFO)\n",
        "if not prod_logger.handlers:\n",
        "    fh = logging.FileHandler('logs/monitoring_prod.log', mode='a')\n",
        "    fh.setFormatter(logging.Formatter('%(asctime)s - [%(levelname)s] - %(message)s'))\n",
        "    prod_logger.addHandler(fh)\n",
        "    sh = logging.StreamHandler()\n",
        "    sh.setFormatter(logging.Formatter('%(asctime)s - %(levelname)s - %(message)s'))\n",
        "    prod_logger.addHandler(sh)\n",
        "\n",
        "# Catálogo de Umbrales SLO\n",
        "UMBRALES_SLO = {\n",
        "    \"recall_min\": 0.90,\n",
        "    \"precision_min\": 0.85,\n",
        "    \"latencia_p95_max_ms\": 150.0,\n",
        "    \"psi_max\": 0.25\n",
        "}\n",
        "\n",
        "# Motor de mitigación automatizada (Runbooks)\n",
        "class AutomatedResponseEngine:\n",
        "    @staticmethod\n",
        "    def ejecutar_rollback_v2():\n",
        "        prod_logger.warning(\"[RUNBOOK RB-001] Iniciando rollback automático inmediato de v3 -> v2 por degradación de Recall.\")\n",
        "        time.sleep(1.0) # Simulación de cambio de balanceador / DNS\n",
        "        prod_logger.info(\"[RUNBOOK RB-001] [STABLE] Rollback exitoso. Tráfico redirigido al Modelo v2 (Recall: 92.3%).\")\n",
        "        return \"v2\"\n",
        "\n",
        "    @staticmethod\n",
        "    def ejecutar_escalamiento_horizontal(replicas_actuales=2):\n",
        "        prod_logger.warning(f\"[RUNBOOK RB-002] Iniciando escalamiento de infraestructura de {replicas_actuales} réplicas a 5 réplicas.\")\n",
        "        time.sleep(1.2) # Simulación de aprovisionamiento de pods en K8s\n",
        "        prod_logger.info(\"[RUNBOOK RB-002] [STABLE] Escalamiento completado. Latencia de checkout p95 normalizada.\")\n",
        "        return 5\n",
        "\n",
        "# Monitoreo Activo de Métricas Transaccionales\n",
        "def monitorear_sistema_fraudes(recall_actual, precision_actual, latencia_p95_ms, dataset_actual=None, dataset_baseline=None):\n",
        "    prod_logger.info(\"--- INICIANDO CICLO DE MONITOREO OPERACIONAL ---\")\n",
        "    alertas_activadas = 0\n",
        "\n",
        "    # 1. Evaluar Recall\n",
        "    if recall_actual < UMBRALES_SLO[\"recall_min\"]:\n",
        "        prod_logger.error(f\"[SLO VIOLATION] Recall actual {recall_actual*100:.1f}% es menor al umbral del {UMBRALES_SLO['recall_min']*100:.1f}%\")\n",
        "        AutomatedResponseEngine.ejecutar_rollback_v2()\n",
        "        alertas_activadas += 1\n",
        "\n",
        "    # 2. Evaluar Latencia p95\n",
        "    if latencia_p95_ms > UMBRALES_SLO[\"latencia_p95_max_ms\"]:\n",
        "        prod_logger.error(f\"[SLO VIOLATION] Latencia p95 actual {latencia_p95_ms}ms supera el límite permitido de {UMBRALES_SLO['latencia_p95_max_ms']}ms\")\n",
        "        AutomatedResponseEngine.ejecutar_escalamiento_horizontal(replicas_actuales=2)\n",
        "        alertas_activadas += 1\n",
        "\n",
        "    # 3. Evaluar Estabilidad (PSI) si se proveen datasets\n",
        "    if dataset_actual is not None and dataset_baseline is not None:\n",
        "        baseline_percents, buckets = np.histogram(dataset_baseline, bins=10, density=True)\n",
        "        target_percents, _ = np.histogram(dataset_actual, bins=buckets, density=True)\n",
        "        baseline_percents = np.where(baseline_percents == 0, 0.0001, baseline_percents)\n",
        "        target_percents = np.where(target_percents == 0, 0.0001, target_percents)\n",
        "        psi = float(np.sum((target_percents - baseline_percents) * np.log(target_percents / baseline_percents)))\n",
        "\n",
        "        if psi >= UMBRALES_SLO[\"psi_max\"]:\n",
        "            prod_logger.error(f\"[DRIFT ALERT] PSI calculado de {psi:.4f} indica deriva crítica de datos (Umbral: {UMBRALES_SLO['psi_max']})\")\n",
        "            alertas_activadas += 1\n",
        "        else:\n",
        "            prod_logger.info(f\"[STATUS OK] Population Stability Index (PSI): {psi:.4f}. Datos estables.\")\n",
        "\n",
        "    if alertas_activadas == 0:\n",
        "        prod_logger.info(\"[STATUS OK] Todos los SLOs e indicadores de estabilidad operan en rangos nominales.\")\n",
        "\n",
        "    prod_logger.info(\"--- CICLO DE MONITOREO FINALIZADO ---\\n\")\n",
